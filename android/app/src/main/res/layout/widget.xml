<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_name" />

    <!-- invisible tap areas: header arrows change month, everything else opens the app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="22" />
            <FrameLayout android:id="@+id/open_top" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="56" />
            <FrameLayout android:id="@+id/next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="22" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/open"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="80" />
    </LinearLayout>
</FrameLayout>
